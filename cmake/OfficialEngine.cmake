include(FetchContent)
if(NOT UNSHIELD_DIR)
    FetchContent_Declare(scbridge_unshield
        URL https://codeload.github.com/twogood/unshield/tar.gz/0788bfb797093fbaaa34a1a8fdcfe2dc496548c3
        URL_HASH SHA256=04a99d2cc1bc8619da48fa17c0534b7fe92b1d366725558819e38cb122ce4541)
    FetchContent_GetProperties(scbridge_unshield)
    if(NOT scbridge_unshield_POPULATED)
        FetchContent_Populate(scbridge_unshield)
    endif()
    set(UNSHIELD_DIR "${scbridge_unshield_SOURCE_DIR}")
endif()
function(scbridge_add_engine_helper)
    if(WIN32)
        get_target_property(modules juce_core INTERFACE_JUCE_MODULE_PATH)
        set(zlib "${modules}/juce_core/zip/zlib")
        set(sources adler32 compress crc32 deflate infback inffast inflate inftrees trees uncompr zutil)
        list(TRANSFORM sources PREPEND "${zlib}/")
        list(TRANSFORM sources APPEND ".c")
        add_library(scbridge_zlib STATIC ${sources})
        target_include_directories(scbridge_zlib PUBLIC "$<BUILD_INTERFACE:${zlib}>")
        add_library(ZLIB::ZLIB ALIAS scbridge_zlib)
        install(TARGETS scbridge_zlib EXPORT unshieldConfig)
        set(ZLIB_INCLUDE_DIR "${zlib}")
        set(ZLIB_LIBRARY scbridge_zlib)
    endif()
    find_package(ZLIB REQUIRED)
    set(BUILD_STATIC ON)
    set(USE_OUR_OWN_MD5 ON)
    set(BUILD_TESTING OFF)
    set(CMAKE_OSX_ARCHITECTURES "arm64;x86_64")
    add_subdirectory("${UNSHIELD_DIR}" "${CMAKE_BINARY_DIR}/unshield" EXCLUDE_FROM_ALL)
    if(MSVC)
        set_target_properties(libunshield md5 PROPERTIES C_STANDARD 17)
    endif()
endfunction()
scbridge_add_engine_helper()
juce_add_console_app(SoundCanvasEngineDownload PRODUCT_NAME "Sound Canvas Engine Download")
target_sources(SoundCanvasEngineDownload PRIVATE "${SOURCE}/OfficialEngineDownload.cpp")
target_compile_definitions(SoundCanvasEngineDownload PRIVATE JUCE_USE_CURL=0)
target_link_libraries(SoundCanvasEngineDownload PRIVATE juce::juce_cryptography juce::juce_recommended_config_flags libunshield)
add_dependencies(SoundCanvasStandalone SoundCanvasEngineDownload)
if(WIN32)
    get_target_property(scbridge_modules juce_core INTERFACE_JUCE_MODULE_PATH)
    set(zlib_notice LICENSE)
    if(SCBRIDGE_WINDOWS7)
        set(zlib_notice README)
    endif()
    target_compile_definitions(SoundCanvasEngineDownload PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_link_libraries(SoundCanvasEngineDownload PRIVATE setupapi)
    add_custom_command(TARGET SoundCanvasStandalone POST_BUILD
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:SoundCanvasEngineDownload>" "$<TARGET_FILE_DIR:SoundCanvasStandalone>/SoundCanvasEngineDownload.exe"
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${UNSHIELD_DIR}/LICENSE" "$<TARGET_FILE_DIR:SoundCanvasStandalone>/Unshield Licence.txt"
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${scbridge_modules}/juce_core/zip/zlib/${zlib_notice}" "$<TARGET_FILE_DIR:SoundCanvasStandalone>/Zlib Licence.txt")
else()
set_target_properties(SoundCanvasEngineDownload PROPERTIES OSX_ARCHITECTURES "arm64;x86_64")
add_custom_command(TARGET SoundCanvasStandalone POST_BUILD
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:SoundCanvasEngineDownload>"
        "$<TARGET_BUNDLE_DIR:SoundCanvasStandalone>/Contents/Resources/SoundCanvasEngineDownload"
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${UNSHIELD_DIR}/LICENSE"
        "$<TARGET_BUNDLE_DIR:SoundCanvasStandalone>/Contents/Resources/Unshield Licence.txt")
endif()
